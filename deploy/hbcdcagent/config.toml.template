# ZeroClaw 数智疾控 daemon 配置模板（非 Docker 直接部署）。
# 复制为 ~/.zeroclaw/config.toml 后填写。不要提交真实密钥。
#
# 注意：模型端点字段是 `uri`（不是 `base_url`）。

schema_version = 3

# ── 网关：可信代理，身份透传 ──────────────────────────
[gateway]
host = "127.0.0.1"          # 只绑 loopback，不对公网
port = 42617
trusted_proxy = true        # 信任 BFF 写入的身份头
path_prefix = "/hbcdcagent"
web_dist_dir = "/opt/zeroclaw/web/dist"
check_updates = false       # 内网离线，不要去查 GitHub 发布
# 交付包 start-*.sh 会用 ZEROCLAW_gateway__web_dist_dir 覆盖为包内 web/dist
# secret 不写这里！用环境变量 ZEROCLAW_gateway__trusted_proxy_secret

# ── 内网模型（vLLM / OpenAI 兼容，无外网）────────────────
# 生产是离线私有模型。不要用 openai.*（不流式、不传 reasoning_effort），
# 也不要用 deepseek.*（漏写 uri 会落到 api.deepseek.com，内网会失败或空等）。
# 用 vllm 族：兼容实现会流式转发思考；漏写 uri 时默认 localhost，不会出公网。
#
# DeepSeek V4 Flash（vLLM 0.22，model 常为 dsv4）要靠请求体顶层
# reasoning_effort 才出思考。[runtime].reasoning_enabled 只作用于 Ollama；
# [runtime].reasoning_effort 按模型名白名单过滤，dsv4 会被丢掉。
# 不要把 reasoning_effort 写成模型段独立字段，那个键不存在。
# uri 填真实内网 IP 或 ASCII 主机名，不要中文/尖括号占位符。
[providers.models.vllm.default]
uri = "http://127.0.0.1:8000/v1"
model = "dsv4"
api_key = "not-needed"
context_window = 128000

[providers.models.vllm.default.provider_extra]
reasoning_effort = "high"

[providers.models.custom.qwen]
uri = "http://127.0.0.1:8001/v1"
model = "qwen-max"
api_key = "not-needed"

# 工作台 URL `/workbench/<alias>` 必须对应下面某个 [agents.<alias>]。
# 未配置的别名（例如书签还是 /workbench/deepseek）会回落到 default，不必复制一份相同的 agent。
# CLI / 直连 daemon 常用 [agents.default]。
[agents.default]
enabled = true
model_provider = "vllm.default"
risk_profile = "default"
runtime_profile = "default"

# 工作台「自主 / 监督 / 只读」可在此天花板内切换。普通用户仍被角色限制为监督。
[risk_profiles.default]
level = "full"

[runtime_profiles.default]
max_context_tokens = 128000

# 每轮只注入技能名称、说明和目录。正文在点选后由 read_skill 读取。
[skills]
prompt_injection_mode = "compact"
