# ZeroClaw 数智疾控 daemon 配置模板（非 Docker 直接部署）。
# 复制为 ~/.zeroclaw/config.toml 后填写。不要提交真实密钥。
#
# 注意：模型端点字段是 `uri`（不是 `base_url`）。

schema_version = 3

# ── 网关：可信代理，身份透传 ──────────────────────────
[gateway]
host = "127.0.0.1"          # 只绑 loopback，不对公网
port = 42617
trusted_proxy = true        # 信任 BFF 写入的身份头
path_prefix = "/hbcdcagent"
web_dist_dir = "/opt/zeroclaw/web/dist"
# 交付包 start-*.sh 会用 ZEROCLAW_gateway__web_dist_dir 覆盖为包内 web/dist
# secret 不写这里！用环境变量 ZEROCLAW_gateway__trusted_proxy_secret

# ── 内网模型（OpenAI 兼容）────────────────────────────
[providers.models.openai.deepseek]
uri = "http://<内网deepseek>/v1"
model = "deepseek-chat"
api_key = "not-needed"
context_window = 128000

[providers.models.openai.qwen]
uri = "http://<内网qwen>/v1"
model = "qwen-max"
api_key = "not-needed"

# ── 代理（alias 必须和工作台 URL 一致）────────────────
# 工作台默认打开 /hbcdcagent/workbench/deepseek，对应 [agents.deepseek]。
# CLI / 直连 daemon 常用 [agents.default]。两个都可以指向同一模型通道。
[agents.default]
enabled = true
model_provider = "openai.deepseek"
risk_profile = "default"
runtime_profile = "default"

[agents.deepseek]
enabled = true
model_provider = "openai.deepseek"
risk_profile = "default"
runtime_profile = "default"

# 工作台「自主 / 监督 / 只读」可在此天花板内切换。普通用户仍被角色限制为监督。
[risk_profiles.default]
level = "full"

[runtime_profiles.default]
max_context_tokens = 128000
