# 复制为 .env 后填写。不要提交真实密钥。

ZEROCLAW_gateway__trusted_proxy_secret=replace-with-long-random
HBCDCAGENT_BFF_UPSTREAM=http://127.0.0.1:42617
HBCDCAGENT_BFF_PUBLIC_ORIGIN=http://88.8.130.150:50001
HBCDCAGENT_BFF_COOKIE_SECURE=false

USER_CENTER_BASE_URL=http://88.7.129.9/openapi
USER_CENTER_APP_ID=
USER_CENTER_APP_KEY=
USER_CENTER_APP_SECRET=
USER_CENTER_SIGN_TYPE=MD5
USER_CENTER_LOGIN_URL=
USER_CENTER_CLIENT_ID=
USER_CENTER_REALM=
USER_CENTER_TERMINAL=Web
# 可选。用户中心若提供登出页，logout 清 cookie 后跳转这里，避免 SSO 自动重登
USER_CENTER_LOGOUT_URL=
HBCDCAGENT_BFF_OPS_USER_IDS=
# 智能预警加密票据 SSO（可选）。两项都填才启用；只填一项 BFF 启动即失败（避免静默拒票）。
# 密钥为 32 字节、标准 Base64。key_version 默认 1。不要提交真实密钥。
HBCDCAGENT_SSO_CLIENT_ID=
HBCDCAGENT_SSO_KEY_B64=
HBCDCAGENT_SSO_KEY_VERSION=1
# 可选。票据验签限流（次/分钟），默认 60。
HBCDCAGENT_SSO_RATE_PER_MIN=
# 可选。允许以 iframe/弹窗嵌入工作台的父页面 origin，逗号分隔。
# 留空即 frame-ancestors 'none'（禁止嵌入）。不要填 *。
HBCDCAGENT_BFF_FRAME_ANCESTORS=
# 本地演示模式：跳过 SSO，从 zeroclaw_mock_user cookie 派生身份（白名单固定）
HBCDCAGENT_BFF_LOCAL_MOCK=false
