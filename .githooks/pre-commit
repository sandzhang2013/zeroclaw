#!/usr/bin/env bash
set -euo pipefail

# One step per commit, recorded in web/WORKBENCH_VERSION. The badge follows
# Cargo.toml [workspace.package] version A.B.C: the band is A.B.(C*100) and
# each commit adds one inside that band. A new kernel patch starts at C*100
# (0.8.8 starts at 0.8.800). Packaging reads the file, so a shallow clone still
# shows the same badge. Merge and amend commits keep the version the staged
# tree already has. ZEROCLAW_SKIP_VERSION_BUMP=1 skips the bump.
bump_workbench_version() {
  if [[ "${ZEROCLAW_SKIP_VERSION_BUMP:-}" == "1" ]]; then
    return 0
  fi
  if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    return 0
  fi
  case "${GIT_REFLOG_ACTION:-}" in
    *amend*) return 0 ;;
  esac

  local others head_ver file_ver index_ver base next
  others="$(git diff --cached --name-only | grep -v '^web/WORKBENCH_VERSION$' || true)"
  if [[ -z "${others}" ]]; then
    return 0
  fi

  head_ver="$(git show "HEAD:web/WORKBENCH_VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
  file_ver="$(tr -d '[:space:]' < web/WORKBENCH_VERSION)"
  index_ver="$(git show ":web/WORKBENCH_VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -n "${head_ver}" && -n "${index_ver}" && "${index_ver}" != "${head_ver}" ]]; then
    return 0
  fi

  if [[ -n "${head_ver}" ]]; then
    base="${head_ver}"
  else
    base="${file_ver}"
  fi
  local kernel
  kernel="$(workspace_package_version)"
  next="$(bump_workbench_patch "${base}" "${kernel}")"
  if [[ "${file_ver}" == "${next}" && "${index_ver}" == "${next}" ]]; then
    return 0
  fi
  printf '%s\n' "${next}" > web/WORKBENCH_VERSION
  git add -- web/WORKBENCH_VERSION
}

workspace_package_version() {
  awk '
    $0 == "[workspace.package]" { in_pkg = 1; next }
    in_pkg && /^\[/ { exit }
    in_pkg && /^version = "/ {
      if (match($0, /"[0-9]+\.[0-9]+\.[0-9]+"/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        exit
      }
    }
  ' Cargo.toml
}

bump_workbench_patch() {
  local version="$1" kernel="$2" major minor patch kmaj kmin kpatch floor
  IFS=. read -r major minor patch <<<"${version}"
  IFS=. read -r kmaj kmin kpatch <<<"${kernel}"
  if [[ ! "${major}" =~ ^[0-9]+$ || ! "${minor}" =~ ^[0-9]+$ || ! "${patch}" =~ ^[0-9]+$ ]]; then
    echo "workbench version: web/WORKBENCH_VERSION must be MAJOR.MINOR.PATCH, got '${version}'" >&2
    return 1
  fi
  if [[ ! "${kmaj}" =~ ^[0-9]+$ || ! "${kmin}" =~ ^[0-9]+$ || ! "${kpatch}" =~ ^[0-9]+$ ]]; then
    echo "workbench version: Cargo.toml [workspace.package] version must be MAJOR.MINOR.PATCH, got '${kernel}'" >&2
    return 1
  fi
  floor="$((kpatch * 100))"
  if [[ "${major}" == "${kmaj}" && "${minor}" == "${kmin}" && "${patch}" -ge "${floor}" && "${patch}" -lt "$((floor + 100))" ]]; then
    printf '%s.%s.%s\n' "${kmaj}" "${kmin}" "$((patch + 1))"
  else
    printf '%s.%s.%s\n' "${kmaj}" "${kmin}" "${floor}"
  fi
}

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"
bump_workbench_version

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
else
  echo "warning: gitleaks not found; skipping staged secret scan" >&2
fi
